# Node.js 24+ local prototype. Environment values are server-side only.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/crm.sqlite
DEMO_MODE=true
# When DEMO_MODE=false, set a private password of at least 12 characters.
# ADMIN_PASSWORD=
# Set true only behind a correctly configured HTTPS reverse proxy.
COOKIE_SECURE=false
# NODE_ENV=production serves the compiled dist directory.
