{
  "name": "sai-balaji-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "vite build",
    "start": "node server.js",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/database.ts migrate",
    "db:seed": "node scripts/database.ts seed",
    "db:reset": "node scripts/database.ts reset",
    "db:backup": "node scripts/database.ts backup",
    "lint": "node scripts/check-source.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
